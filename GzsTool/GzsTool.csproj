<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>GzsTool</RootNamespace>
    <AssemblyName>GzsTool</AssemblyName>
    <LangVersion>12.0</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <DebugType>embedded</DebugType>
    <RestoreProjectStyle>PackageReference</RestoreProjectStyle>
    <!-- Culture-independent string handling, and no ICU dependency to ship. -->
    <InvariantGlobalization>true</InvariantGlobalization>
    <!-- XmlSerializer leans on reflection, so trimming and Native AOT are deliberately left off. -->
    <PublishTrimmed>false</PublishTrimmed>
  </PropertyGroup>

  <!-- Publishing for a specific OS (dotnet publish -r osx-arm64) gives one self-standing executable. -->
  <PropertyGroup Condition="'$(RuntimeIdentifier)' != ''">
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\GzsTool.Core\GzsTool.Core.csproj" />
  </ItemGroup>

  <!-- The hash dictionaries have to sit next to the executable; they are looked up at startup. -->
  <ItemGroup>
    <None Update="fpk_dictionary.txt" CopyToOutputDirectory="PreserveNewest" />
    <None Update="qar_dictionary.txt" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
