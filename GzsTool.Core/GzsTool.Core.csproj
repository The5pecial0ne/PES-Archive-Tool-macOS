<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>GzsTool.Core</RootNamespace>
    <AssemblyName>GzsTool.Core</AssemblyName>
    <!-- The code base predates nullable reference types, implicit usings and the newer C# keywords, so keep those off. -->
    <LangVersion>12.0</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- Properties/AssemblyInfo.cs already carries the assembly attributes. -->
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <DebugType>embedded</DebugType>
    <!-- No NuGet packages any more: zlib comes from the runtime and CityHash is a project in this repo. -->
    <RestoreProjectStyle>PackageReference</RestoreProjectStyle>
    <!-- The original code reads with Stream.Read in a way that is fine for files on disk. -->
    <NoWarn>$(NoWarn);CA2022</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\CityHash\CityHash.csproj" />
  </ItemGroup>

</Project>
